        private void LoadPOSCategories()
        {
            try
            {
                // Use database table dbo.DanhMuc (MaDanhMuc, TenDanhMuc)
                string query = "SELECT MaDanhMuc AS CategoryID, TenDanhMuc AS CategoryName FROM dbo.DanhMuc WHERE DangHoatDong = 1 ORDER BY MaDanhMuc";
                DataTable dt = DatabaseHelper.ExecuteQuery(query);
                var row = dt.NewRow();
                row["CategoryID"] = 0;
                row["CategoryName"] = "--- Tất cả danh mục ---";
                dt.Rows.InsertAt(row, 0);

                cboPOSCategory.DataSource = dt;
                cboPOSCategory.DisplayMember = "CategoryName";
                cboPOSCategory.ValueMember = "CategoryID";
            }
            catch (Exception ex)
            {
                MessageBox.Show("Lỗi tải danh mục: " + ex.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void LoadPOSProducts()
        {
            try
            {
                int catId = 0;
                if (cboPOSCategory.SelectedValue != null && int.TryParse(cboPOSCategory.SelectedValue.ToString(), out int val))
                {
                    catId = val;
                }

                string search = txtPOSSearch.Text.Trim();

                // Query SanPham and join DanhMuc, DonVi and SanPham_ChiNhanh for branch price
                string query = @"
                    SELECT sp.MaSanPham AS ProductID,
                           sp.MaSKU AS [Mã Món],
                           sp.TenSanPham AS [Tên Món],
                           dm.TenDanhMuc AS [Danh Mục],
                           ISNULL(spcn.GiaBan, 0) AS [Giá Bán (VNĐ)],
                           dv.TenDonVi AS [ĐVT]
                    FROM dbo.SanPham sp
                    JOIN dbo.DanhMuc dm ON sp.MaDanhMuc = dm.MaDanhMuc
                    JOIN dbo.DonVi dv ON sp.MaDonViBan = dv.MaDonVi
                    LEFT JOIN dbo.SanPham_ChiNhanh spcn ON sp.MaSanPham = spcn.MaSanPham AND spcn.MaChiNhanh = @MaChiNhanh
                    WHERE sp.DangHoatDong = 1";

                var parameters = new List<SqlParameter>
                {
                    new SqlParameter("@MaChiNhanh", System.Data.SqlDbType.Int) { Value = UserSession.MaChiNhanh }
                };

                if (catId > 0)
                {
                    query += " AND sp.MaDanhMuc = @CatID";
                    parameters.Add(new SqlParameter("@CatID", System.Data.SqlDbType.Int) { Value = catId });
                }

                if (!string.IsNullOrEmpty(search))
                {
                    query += " AND (sp.TenSanPham LIKE @Search OR sp.MaSKU LIKE @Search)";
                    parameters.Add(new SqlParameter("@Search", System.Data.SqlDbType.NVarChar, 200) { Value = "%" + search + "%" });
                }

                query += " ORDER BY sp.MaSanPham";

                DataTable dt = DatabaseHelper.ExecuteQuery(query, parameters.ToArray());
                dgvPOSMenu.DataSource = dt;
                if (dgvPOSMenu.Columns["ProductID"] != null)
                    dgvPOSMenu.Columns["ProductID"].Visible = false;

                if (dgvPOSMenu.Columns["Giá Bán (VNĐ)"] != null)
                    dgvPOSMenu.Columns["Giá Bán (VNĐ)"].DefaultCellStyle.Format = "N0";
            }
            catch (Exception ex)
            {
                MessageBox.Show("Lỗi tải thực đơn: " + ex.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void AddSelectedProductToCart()
        {
            if (dgvPOSMenu.CurrentRow == null) return;

            int productId = Convert.ToInt32(dgvPOSMenu.CurrentRow.Cells["ProductID"].Value);
            string code = dgvPOSMenu.CurrentRow.Cells["Mã Món"].Value.ToString() ?? "";
            string name = dgvPOSMenu.CurrentRow.Cells["Tên Món"].Value.ToString() ?? "";
            decimal price = Convert.ToDecimal(dgvPOSMenu.CurrentRow.Cells["Giá Bán (VNĐ)"].Value);

            // Kiểm tra món đã có trong giỏ hàng chưa
            DataRow[] existing = _cartTable.Select("ProductID = " + productId);
            if (existing.Length > 0)
            {
                existing[0]["Quantity"] = Convert.ToDecimal(existing[0]["Quantity"]) + 1;
                existing[0]["TotalAmount"] = Convert.ToDecimal(existing[0]["Quantity"]) * price;
            }
            else
            {
                var newRow = _cartTable.NewRow();
                newRow["ProductID"] = productId;
                newRow["ProductCode"] = code;
                newRow["ProductName"] = name;
                newRow["UnitPrice"] = price;
                newRow["Quantity"] = 1;
                newRow["TotalAmount"] = price;
                _cartTable.Rows.Add(newRow);
            }

            RecalculateCart();
        }

        private decimal _totalOrderAmount = 0;
        private decimal _finalOrderAmount = 0;

        private void RecalculateCart()
        {
            _totalOrderAmount = 0;
            foreach (DataRow row in _cartTable.Rows)
            {
                decimal qty = Convert.ToDecimal(row["Quantity"]);
                decimal price = Convert.ToDecimal(row["UnitPrice"]);
                row["TotalAmount"] = qty * price;
                _totalOrderAmount += qty * price;
            }

            lblPOSTotal.Text = _totalOrderAmount.ToString("N0", _vnCulture) + " đ";

            decimal discount = numPOSDiscount.Value;
            _finalOrderAmount = Math.Max(0, _totalOrderAmount - discount);
            lblPOSFinal.Text = _finalOrderAmount.ToString("N0", _vnCulture) + " đ";

            CalculateChangeMoney();
        }

        private void CalculateChangeMoney()
        {
            if (decimal.TryParse(txtPOSCustomerMoney.Text.Replace(",", "").Replace(".", "").Trim(), out decimal customerMoney))
            {
                decimal change = customerMoney - _finalOrderAmount;
                if (change >= 0)
                {
                    lblPOSChange.Text = change.ToString("N0", _vnCulture) + " đ";
                    lblPOSChange.ForeColor = Color.FromArgb(39, 174, 96);
                }
                else
                {
                    lblPOSChange.Text = "Thiếu: " + Math.Abs(change).ToString("N0", _vnCulture) + " đ";
                    lblPOSChange.ForeColor = Color.FromArgb(192, 57, 43);
                }
            }
            else
            {
                lblPOSChange.Text = "0 đ";
            }
        }

        private void ClearPOSCart()
        {
            _cartTable.Rows.Clear();
            numPOSDiscount.Value = 0;
            txtPOSCustomerMoney.Clear();
            txtPOSNote.Clear();
            RecalculateCart();
        }

        private void ProcessPOSCheckout()
        {
            if (_cartTable.Rows.Count == 0)
            {
                MessageBox.Show("Giỏ hàng đang trống! Vui lòng chọn món trước khi thanh toán.", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            string orderCode = "HD" + DateTime.Now.ToString("yyyyMMddHHmmss");
            decimal subTotal = _totalOrderAmount;
            decimal discount = numPOSDiscount.Value;
            decimal totalAmount = _finalOrderAmount;
            string paymentMethod = cboPOSPaymentMethod.SelectedIndex == 1 ? "BANK_TRANSFER" : "CASH";
            string note = txtPOSNote.Text.Trim();

            try
            {
                using var conn = DatabaseHelper.GetConnection();
                conn.Open();
                using var transaction = conn.BeginTransaction();

                // 1. Insert HoaDon
                string insertHoaDonSql = @"
                    INSERT INTO dbo.HoaDon (MaDonLocal, MaChiNhanh, MaThuNgan, NguonDon, LoaiDon, TongTienHang, TienGiam, PhiShip, TongThanhToan, TrangThaiDon, TrangThaiThanhToan)
                    VALUES (@MaDonLocal, @MaChiNhanh, @MaThuNgan, @NguonDon, @LoaiDon, @TongTienHang, @TienGiam, @PhiShip, @TongThanhToan, @TrangThaiDon, @TrangThaiThanhToan);
                    SELECT SCOPE_IDENTITY();";

                var hdParams = new SqlParameter[]
                {
                    new SqlParameter("@MaDonLocal", System.Data.SqlDbType.NVarChar, 50) { Value = orderCode },
                    new SqlParameter("@MaChiNhanh", System.Data.SqlDbType.Int) { Value = UserSession.MaChiNhanh },
                    new SqlParameter("@MaThuNgan", System.Data.SqlDbType.Int) { Value = UserSession.MaNhanVien },
                    new SqlParameter("@NguonDon", System.Data.SqlDbType.NVarChar, 30) { Value = "POS" },
                    new SqlParameter("@LoaiDon", System.Data.SqlDbType.NVarChar, 20) { Value = "TaiQuay" },
                    new SqlParameter("@TongTienHang", System.Data.SqlDbType.Decimal) { Value = subTotal },
                    new SqlParameter("@TienGiam", System.Data.SqlDbType.Decimal) { Value = discount },
                    new SqlParameter("@PhiShip", System.Data.SqlDbType.Decimal) { Value = 0m },
                    new SqlParameter("@TongThanhToan", System.Data.SqlDbType.Decimal) { Value = totalAmount },
                    new SqlParameter("@TrangThaiDon", System.Data.SqlDbType.NVarChar, 20) { Value = "XacNhan" },
                    new SqlParameter("@TrangThaiThanhToan", System.Data.SqlDbType.NVarChar, 20) { Value = "DaTT" }
                };

                int maHoaDon = Convert.ToInt32(DatabaseHelper.ExecuteScalar(insertHoaDonSql, hdParams, conn, transaction));

                // 2. Insert ChiTiet_HoaDon
                foreach (DataRow row in _cartTable.Rows)
                {
                    int maSanPham = Convert.ToInt32(row["ProductID"]);
                    string tenSanPham = row["ProductName"].ToString() ?? string.Empty;
                    decimal qty = Convert.ToDecimal(row["Quantity"]);
                    decimal unitPrice = Convert.ToDecimal(row["UnitPrice"]);
                    decimal thanhTien = qty * unitPrice;

                    string insertCTSql = @"
                        INSERT INTO dbo.ChiTiet_HoaDon (MaHoaDon, MaSanPham, TenSanPhamChup, SoLuong, DonGia, GiamDong, ThanhTien)
                        VALUES (@MaHoaDon, @MaSanPham, @TenSanPhamChup, @SoLuong, @DonGia, 0, @ThanhTien);";

                    var ctParams = new SqlParameter[]
                    {
                        new SqlParameter("@MaHoaDon", System.Data.SqlDbType.Int) { Value = maHoaDon },
                        new SqlParameter("@MaSanPham", System.Data.SqlDbType.Int) { Value = maSanPham },
                        new SqlParameter("@TenSanPhamChup", System.Data.SqlDbType.NVarChar, 200) { Value = tenSanPham },
                        new SqlParameter("@SoLuong", System.Data.SqlDbType.Decimal) { Value = qty },
                        new SqlParameter("@DonGia", System.Data.SqlDbType.Decimal) { Value = unitPrice },
                        new SqlParameter("@ThanhTien", System.Data.SqlDbType.Decimal) { Value = thanhTien }
                    };

                    DatabaseHelper.ExecuteNonQuery(insertCTSql, ctParams, conn, transaction);

                    // 3. For each product, deduct ingredients according to CongThuc
                    string congThucSql = "SELECT MaNguyenLieu, SoLuongTrenMotPhan FROM dbo.CongThuc WHERE MaSanPham = @MaSanPham";
                    var ctqParams = new SqlParameter[] { new SqlParameter("@MaSanPham", System.Data.SqlDbType.Int) { Value = maSanPham } };
                    DataTable dtCongThuc = DatabaseHelper.ExecuteQuery(congThucSql, ctqParams, conn, transaction);

                    foreach (DataRow ctRow in dtCongThuc.Rows)
                    {
                        int maNguyenLieu = Convert.ToInt32(ctRow["MaNguyenLieu"]);
                        decimal soLuongTrenMotPhan = Convert.ToDecimal(ctRow["SoLuongTrenMotPhan"]);
                        decimal required = Math.Round(soLuongTrenMotPhan * qty, 3);

                        // Get current stock
                        string selTonSql = "SELECT SoLuongTon FROM dbo.TonKho_ChiNhanh WHERE MaChiNhanh = @MaChiNhanh AND MaNguyenLieu = @MaNguyenLieu";
                        var tonParams = new SqlParameter[]
                        {
                            new SqlParameter("@MaChiNhanh", System.Data.SqlDbType.Int) { Value = UserSession.MaChiNhanh },
                            new SqlParameter("@MaNguyenLieu", System.Data.SqlDbType.Int) { Value = maNguyenLieu }
                        };

                        object? tonObj = DatabaseHelper.ExecuteScalar(selTonSql, tonParams, conn, transaction);
                        decimal currentTon = tonObj == null || tonObj == DBNull.Value ? 0m : Convert.ToDecimal(tonObj);

                        if (currentTon < required)
                        {
                            // Get ingredient name for better message
                            string nameSql = "SELECT TenNguyenLieu FROM dbo.NguyenLieu WHERE MaNguyenLieu = @MaNguyenLieu";
                            var nameObj = DatabaseHelper.ExecuteScalar(nameSql, new SqlParameter[] { new SqlParameter("@MaNguyenLieu", System.Data.SqlDbType.Int) { Value = maNguyenLieu } }, conn, transaction);
                            string ingName = nameObj == null || nameObj == DBNull.Value ? ("ID=" + maNguyenLieu) : nameObj.ToString() ?? ("ID=" + maNguyenLieu);

                            throw new Exception($"Nguyên liệu '{ingName}' trong kho không đủ. Cần {required.ToString("N3", _vnCulture)} nhưng chỉ còn {currentTon.ToString("N3", _vnCulture)}.");
                        }

                        // Update TonKho_ChiNhanh
                        string updTonSql = @"UPDATE dbo.TonKho_ChiNhanh SET SoLuongTon = SoLuongTon - @Delta, NgayCapNhat = SYSUTCDATETIME()
                                            WHERE MaChiNhanh = @MaChiNhanh AND MaNguyenLieu = @MaNguyenLieu";
                        var updParams = new SqlParameter[]
                        {
                            new SqlParameter("@Delta", System.Data.SqlDbType.Decimal) { Value = required },
                            new SqlParameter("@MaChiNhanh", System.Data.SqlDbType.Int) { Value = UserSession.MaChiNhanh },
                            new SqlParameter("@MaNguyenLieu", System.Data.SqlDbType.Int) { Value = maNguyenLieu }
                        };

                        DatabaseHelper.ExecuteNonQuery(updTonSql, updParams, conn, transaction);

                        decimal tonSau = currentTon - required;

                        // Insert NhatKy_Kho
                        string insNKSql = @"INSERT INTO dbo.NhatKy_Kho (MaChiNhanh, MaNguyenLieu, LoaiGiaoDich, SoLuongThayDoi, TonSau, MaNhanVien, LoaiThamChieu, MaThamChieu, GhiChu)
                                            VALUES (@MaChiNhanh, @MaNguyenLieu, @LoaiGiaoDich, @SoLuongThayDoi, @TonSau, @MaNhanVien, @LoaiThamChieu, @MaThamChieu, @GhiChu)";
                        var nkParams = new SqlParameter[]
                        {
                            new SqlParameter("@MaChiNhanh", System.Data.SqlDbType.Int) { Value = UserSession.MaChiNhanh },
                            new SqlParameter("@MaNguyenLieu", System.Data.SqlDbType.Int) { Value = maNguyenLieu },
                            new SqlParameter("@LoaiGiaoDich", System.Data.SqlDbType.NVarChar, 30) { Value = "XUAT_BAN" },
                            new SqlParameter("@SoLuongThayDoi", System.Data.SqlDbType.Decimal) { Value = -required },
                            new SqlParameter("@TonSau", System.Data.SqlDbType.Decimal) { Value = tonSau },
                            new SqlParameter("@MaNhanVien", System.Data.SqlDbType.Int) { Value = UserSession.MaNhanVien },
                            new SqlParameter("@LoaiThamChieu", System.Data.SqlDbType.NVarChar, 30) { Value = "HOADON" },
                            new SqlParameter("@MaThamChieu", System.Data.SqlDbType.Int) { Value = maHoaDon },
                            new SqlParameter("@GhiChu", System.Data.SqlDbType.NVarChar, 255) { Value = string.IsNullOrEmpty(note) ? (object)DBNull.Value : note }
                        };

                        DatabaseHelper.ExecuteNonQuery(insNKSql, nkParams, conn, transaction);
                    }
                }

                // 4. Insert ThanhToan_HoaDon
                string insertTTSql = @"INSERT INTO dbo.ThanhToan_HoaDon (MaHoaDon, HinhThuc, SoTien, MaThamChieu, NguoiThu) VALUES (@MaHoaDon, @HinhThuc, @SoTien, @MaThamChieu, @NguoiThu)";
                var ttParams = new SqlParameter[]
                {
                    new SqlParameter("@MaHoaDon", System.Data.SqlDbType.Int) { Value = maHoaDon },
                    new SqlParameter("@HinhThuc", System.Data.SqlDbType.NVarChar, 30) { Value = paymentMethod },
                    new SqlParameter("@SoTien", System.Data.SqlDbType.Decimal) { Value = totalAmount },
                    new SqlParameter("@MaThamChieu", System.Data.SqlDbType.NVarChar, 100) { Value = DBNull.Value },
                    new SqlParameter("@NguoiThu", System.Data.SqlDbType.Int) { Value = UserSession.MaNhanVien }
                };

                DatabaseHelper.ExecuteNonQuery(insertTTSql, ttParams, conn, transaction);

                // Commit all
                transaction.Commit();

                string msg = "Thanh toán thành công!\n\nMã hóa đơn: " + orderCode + "\nTổng tiền: " + totalAmount.ToString("N0", _vnCulture) + " đ\nTồn kho nguyên liệu đã được cập nhật.";
                MessageBox.Show(msg, "Thành công", MessageBoxButtons.OK, MessageBoxIcon.Information);

                ClearPOSCart();
                LoadIngredientsTab(); // refresh stock
                LoadReportsTab();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Lỗi khi thanh toán đơn hàng:\n" + ex.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

