        private void LoadReportsTab()
        {
            try
            {
                // Doanh thu theo ngày: aggregate HoaDon/ThanhToan_HoaDon per date for current branch
                string queryDaily = @"
                    SELECT CAST(hd.NgayTao AS date) AS [Ngày Bán],
                           COUNT(DISTINCT hd.MaHoaDon) AS [Số Đơn Hàng],
                           ISNULL(SUM(tt.SoTien),0) AS [Doanh Thu (VNĐ)]
                    FROM dbo.HoaDon hd
                    LEFT JOIN dbo.ThanhToan_HoaDon tt ON hd.MaHoaDon = tt.MaHoaDon
                    WHERE hd.MaChiNhanh = @MaChiNhanh
                    GROUP BY CAST(hd.NgayTao AS date)
                    ORDER BY [Ngày Bán] DESC";

                var pDaily = new SqlParameter[] { new SqlParameter("@MaChiNhanh", UserSession.MaChiNhanh) };
                DataTable dtDaily = DatabaseHelper.ExecuteQuery(queryDaily, pDaily);
                dgvDailyRevenue.DataSource = dtDaily;
                if (dgvDailyRevenue.Columns["Doanh Thu (VNĐ)"] != null)
                    dgvDailyRevenue.Columns["Doanh Thu (VNĐ)"].DefaultCellStyle.Format = "N0";

                // Bán theo món
                // Top products sold: aggregate ChiTiet_HoaDon joined SanPham, limited to current branch's sales
                string querySales = @"
                    SELECT sp.MaSanPham AS [Mã Món], sp.TenSanPham AS [Tên Món],
                           SUM(ct.SoLuong) AS [Số Lượng Bán],
                           ISNULL(SUM(ct.ThanhTien),0) AS [Tổng Thu (VNĐ)]
                    FROM dbo.ChiTiet_HoaDon ct
                    INNER JOIN dbo.HoaDon hd ON ct.MaHoaDon = hd.MaHoaDon
                    LEFT JOIN dbo.SanPham sp ON ct.MaSanPham = sp.MaSanPham
                    WHERE hd.MaChiNhanh = @MaChiNhanh
                    GROUP BY sp.MaSanPham, sp.TenSanPham
                    ORDER BY [Số Lượng Bán] DESC";

                var pSales = new SqlParameter[] { new SqlParameter("@MaChiNhanh", UserSession.MaChiNhanh) };
                DataTable dtSales = DatabaseHelper.ExecuteQuery(querySales, pSales);
                dgvTopProducts.DataSource = dtSales;
                if (dgvTopProducts.Columns["Tổng Thu (VNĐ)"] != null)
                    dgvTopProducts.Columns["Tổng Thu (VNĐ)"].DefaultCellStyle.Format = "N0";

                // Tính tổng Card
                decimal totalRev = 0;
                int totalOrders = 0;
                foreach (DataRow r in dtDaily.Rows)
                {
                    totalRev += Convert.ToDecimal(r["Doanh Thu (VNĐ)"]);
                    totalOrders += Convert.ToInt32(r["Số Đơn Hàng"]);
                }

                lblReportTotalRev.Text = totalRev.ToString("N0", _vnCulture) + " đ";
                lblReportTotalOrders.Text = totalOrders.ToString() + " đơn";
            }
            catch (Exception ex)
            {
                MessageBox.Show("Lỗi tải báo cáo: " + ex.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

