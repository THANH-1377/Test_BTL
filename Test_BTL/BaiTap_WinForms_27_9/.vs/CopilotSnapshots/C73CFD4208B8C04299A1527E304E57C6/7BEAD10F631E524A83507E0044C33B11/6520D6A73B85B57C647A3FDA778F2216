        private void LoadIngredientsTab()
        {
            try
            {
                string query;
                if (chkLowStockOnly.Checked)
                {
                    query = @"
                        SELECT nl.MaNguyenLieu AS IngredientID, nl.MaNguyenLieu AS [Mã NL], nl.TenNguyenLieu AS [Tên Nguyên Liệu],
                               dv.TenDonVi AS [ĐVT], ISNULL(tk.SoLuongTon,0) AS [Tồn Kho], nl.TonToiThieuCanhBao AS [Tồn Tối Thiểu], 0 AS [Giá Vốn]
                        FROM dbo.NguyenLieu nl
                        LEFT JOIN dbo.DonVi dv ON nl.MaDonViGoc = dv.MaDonVi
                        LEFT JOIN dbo.TonKho_ChiNhanh tk ON nl.MaNguyenLieu = tk.MaNguyenLieu AND tk.MaChiNhanh = @MaChiNhanh
                        WHERE ISNULL(tk.SoLuongTon,0) <= ISNULL(nl.TonToiThieuCanhBao,0) AND nl.DangHoatDong = 1
                        ORDER BY [Tồn Kho] ASC";
                    var pLow = new SqlParameter[] { new SqlParameter("@MaChiNhanh", UserSession.MaChiNhanh) };
                    DataTable dtLow = DatabaseHelper.ExecuteQuery(query, pLow);
                    dgvIngredients.DataSource = dtLow;
                    if (dgvIngredients.Columns["IngredientID"] != null)
                        dgvIngredients.Columns["IngredientID"].Visible = false;

                    if (dgvIngredients.Columns["Giá Vốn"] != null)
                        dgvIngredients.Columns["Giá Vốn"].DefaultCellStyle.Format = "N0";
                    return;
                }

                query = @"
                        SELECT nl.MaNguyenLieu AS IngredientID, nl.MaNguyenLieu AS [Mã NL], nl.TenNguyenLieu AS [Tên Nguyên Liệu],
                               dv.TenDonVi AS [ĐVT], ISNULL(tk.SoLuongTon,0) AS [Tồn Kho], nl.TonToiThieuCanhBao AS [Tồn Tối Thiểu], 0 AS [Giá Vốn]
                        FROM dbo.NguyenLieu nl
                        LEFT JOIN dbo.DonVi dv ON nl.MaDonViGoc = dv.MaDonVi
                        LEFT JOIN dbo.TonKho_ChiNhanh tk ON nl.MaNguyenLieu = tk.MaNguyenLieu AND tk.MaChiNhanh = @MaChiNhanh
                        WHERE nl.DangHoatDong = 1
                        ORDER BY nl.MaNguyenLieu";

                var p = new SqlParameter[] { new SqlParameter("@MaChiNhanh", UserSession.MaChiNhanh) };
                DataTable dt = DatabaseHelper.ExecuteQuery(query, p);
                dgvIngredients.DataSource = dt;
                if (dgvIngredients.Columns["IngredientID"] != null)
                    dgvIngredients.Columns["IngredientID"].Visible = false;

                if (dgvIngredients.Columns["Giá Vốn"] != null)
                    dgvIngredients.Columns["Giá Vốn"].DefaultCellStyle.Format = "N0";
            }
            catch (Exception ex)
            {
                MessageBox.Show("Lỗi tải kho nguyên liệu: " + ex.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void BindIngredientToForm()
        {
            if (dgvIngredients.CurrentRow == null) return;
            var row = dgvIngredients.CurrentRow;
            _selectedIngredientID = Convert.ToInt32(row.Cells["IngredientID"].Value);
            // NguyenLieu has no separate code column in new DB; use MaNguyenLieu as code
            txtIngCode.Text = row.Cells["Mã NL"].Value.ToString();
            txtIngName.Text = row.Cells["Tên Nguyên Liệu"].Value.ToString();
            txtIngUnit.Text = row.Cells["ĐVT"].Value.ToString();
            numIngCurrentStock.Value = Convert.ToDecimal(row.Cells["Tồn Kho"].Value);
            numIngMinStock.Value = Convert.ToDecimal(row.Cells["Tồn Tối Thiểu"].Value);
            // Giá Vốn not available in schema; keep 0 default
            numIngCost.Value = 0;
        }

        private void SaveIngredient()
        {
            string code = txtIngCode.Text.Trim();
            string name = txtIngName.Text.Trim();
            if (string.IsNullOrEmpty(code) || string.IsNullOrEmpty(name))
            {
                MessageBox.Show("Vui lòng nhập Mã và Tên nguyên liệu!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            try
            {
                // In the new DB NguyenLieu and TonKho_ChiNhanh separate master and stock per branch.
                // We'll update NguyenLieu (TenNguyenLieu, MaDonViGoc, TonToiThieuCanhBao, DangHoatDong) and upsert TonKho_ChiNhanh for stock.
                if (_selectedIngredientID > 0)
                {
                    string updateNl = @"UPDATE dbo.NguyenLieu SET TenNguyenLieu = @Name, MaDonViGoc = @MaDonVi, TonToiThieuCanhBao = @Min WHERE MaNguyenLieu = @ID";
                    var pNl = new SqlParameter[]
                    {
                        new SqlParameter("@ID", _selectedIngredientID),
                        new SqlParameter("@Name", name),
                        new SqlParameter("@MaDonVi", txtIngUnit.Text.Trim()),
                        new SqlParameter("@Min", numIngMinStock.Value)
                    };

                    DatabaseHelper.ExecuteNonQuery(updateNl, pNl);

                    // Upsert TonKho_ChiNhanh
                    string upsertStock = @"
IF EXISTS (SELECT 1 FROM dbo.TonKho_ChiNhanh WHERE MaChiNhanh = @MaChiNhanh AND MaNguyenLieu = @ID)
    UPDATE dbo.TonKho_ChiNhanh SET SoLuongTon = @Current WHERE MaChiNhanh = @MaChiNhanh AND MaNguyenLieu = @ID
ELSE
    INSERT INTO dbo.TonKho_ChiNhanh (MaChiNhanh, MaNguyenLieu, SoLuongTon) VALUES (@MaChiNhanh, @ID, @Current)";
                    var pStock = new SqlParameter[]
                    {
                        new SqlParameter("@MaChiNhanh", UserSession.MaChiNhanh),
                        new SqlParameter("@ID", _selectedIngredientID),
                        new SqlParameter("@Current", numIngCurrentStock.Value)
                    };
                    DatabaseHelper.ExecuteNonQuery(upsertStock, pStock);

                    MessageBox.Show("Cập nhật nguyên liệu thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
                else
                {
                    // Insert new NguyenLieu and its stock
                    string insertNl = @"INSERT INTO dbo.NguyenLieu (TenNguyenLieu, MaDonViGoc, TonToiThieuCanhBao, DangHoatDong) VALUES (@Name, @MaDonVi, @Min, 1); SELECT SCOPE_IDENTITY();";
                    var pNl = new SqlParameter[]
                    {
                        new SqlParameter("@Name", name),
                        new SqlParameter("@MaDonVi", txtIngUnit.Text.Trim()),
                        new SqlParameter("@Min", numIngMinStock.Value)
                    };
                    object newIdObj = DatabaseHelper.ExecuteScalar(insertNl, pNl);
                    int newId = Convert.ToInt32(newIdObj);

                    string insertStock = @"INSERT INTO dbo.TonKho_ChiNhanh (MaChiNhanh, MaNguyenLieu, SoLuongTon) VALUES (@MaChiNhanh, @ID, @Current)";
                    var pStock = new SqlParameter[]
                    {
                        new SqlParameter("@MaChiNhanh", UserSession.MaChiNhanh),
                        new SqlParameter("@ID", newId),
                        new SqlParameter("@Current", numIngCurrentStock.Value)
                    };
                    DatabaseHelper.ExecuteNonQuery(insertStock, pStock);

                    MessageBox.Show("Thêm nguyên liệu mới thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }

                LoadIngredientsTab();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Lỗi lưu nguyên liệu: " + ex.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void QuickAddStock()
        {
            if (_selectedIngredientID == 0)
            {
                MessageBox.Show("Vui lòng chọn nguyên liệu cần nhập thêm!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            numIngCurrentStock.Value += 10;
            SaveIngredient();
        }

