        private void BuildDynamicMenu()
        {
            try
            {
                // Remove existing dynamic menu if any
                if (menuStripDynamic != null && Controls.Contains(menuStripDynamic))
                {
                    Controls.Remove(menuStripDynamic);
                    menuStripDynamic.Dispose();
                }

                menuStripDynamic = new MenuStrip { Dock = DockStyle.Top, BackColor = Color.WhiteSmoke };

                string sql;
                SqlParameter[]? parameters = null;
                if (UserSession.IsAdmin)
                {
                    sql = "SELECT MaMenu, MaCode, MaMenuCha, TenHienThi, MaForm, Loai, ThuTu FROM dbo.MenuChucNang ORDER BY ThuTu";
                }
                else
                {
                    sql = @"SELECT m.MaMenu, m.MaCode, m.MaMenuCha, m.TenHienThi, m.MaForm, m.Loai, m.ThuTu
                            FROM dbo.MenuChucNang m
                            JOIN dbo.VaiTro_Menu vm ON m.MaMenu = vm.MaMenu
                            JOIN dbo.VaiTro vt ON vm.MaVaiTro = vt.MaVaiTro
                            WHERE vt.MaCode = @MaCode
                            ORDER BY m.ThuTu";
                    parameters = new SqlParameter[] { new SqlParameter("@MaCode", System.Data.SqlDbType.NVarChar, 30) { Value = UserSession.MaVaiTroCode } };
                }

                DataTable dt = DatabaseHelper.ExecuteQuery(sql, parameters);

                // Build menu items map by MaMenu
                var map = new Dictionary<int, ToolStripMenuItem>();
                foreach (DataRow row in dt.Rows)
                {
                    int maMenu = Convert.ToInt32(row["MaMenu"]);
                    string loai = row["Loai"].ToString() ?? "Trang";
                    string ten = row["TenHienThi"].ToString() ?? "";
                    string maForm = row["MaForm"] == DBNull.Value ? string.Empty : row["MaForm"].ToString() ?? string.Empty;

                    var item = new ToolStripMenuItem(ten) { Tag = maForm };
                    if (!string.IsNullOrEmpty(maForm))
                    {
                        item.Click += (s, e) =>
                        {
                            try
                            {
                                string formName = (string)((ToolStripMenuItem)s).Tag;
                                if (string.IsNullOrEmpty(formName)) return;
                                // Try to find the form type in current assembly
                                var asm = typeof(FormMain).Assembly;
                                var fullName = "BaiTap_WinForms.Forms." + formName;
                                var type = asm.GetType(fullName) ?? Type.GetType(fullName);
                                if (type == null)
                                {
                                    MessageBox.Show($"Không tìm thấy Form: {formName}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                                    return;
                                }
                                var frm = Activator.CreateInstance(type) as Form;
                                if (frm == null)
                                {
                                    MessageBox.Show($"Không thể mở Form: {formName}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                                    return;
                                }
                                frm.StartPosition = FormStartPosition.CenterParent;
                                frm.Show(this);
                            }
                            catch (Exception ex)
                            {
                                MessageBox.Show("Lỗi khi mở form: " + ex.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                            }
                        };
                    }

                    map[maMenu] = item;
                }

                // Attach hierarchy: top-level where MaMenuCha is null
                foreach (DataRow row in dt.Rows)
                {
                    int maMenu = Convert.ToInt32(row["MaMenu"]);
                    object maMenuChaObj = row["MaMenuCha"];
                    if (maMenuChaObj == DBNull.Value)
                    {
                        menuStripDynamic.Items.Add(map[maMenu]);
                    }
                    else
                    {
                        int maMenuCha = Convert.ToInt32(maMenuChaObj);
                        if (map.ContainsKey(maMenuCha))
                        {
                            map[maMenuCha].DropDownItems.Add(map[maMenu]);
                        }
                        else
                        {
                            // Fallback: add to top
                            menuStripDynamic.Items.Add(map[maMenu]);
                        }
                    }
                }

                // Insert menuStripDynamic at top of controls so it doesn't overlap other top controls
                Controls.Add(menuStripDynamic);
                menuStripDynamic.BringToFront();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Lỗi khi tải menu động: " + ex.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }


        private void btnLogout_Click(object sender, EventArgs e)
        {
            var result = MessageBox.Show("Bạn có chắc chắn muốn đăng xuất không?", "Xác nhận", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (result == DialogResult.Yes)
