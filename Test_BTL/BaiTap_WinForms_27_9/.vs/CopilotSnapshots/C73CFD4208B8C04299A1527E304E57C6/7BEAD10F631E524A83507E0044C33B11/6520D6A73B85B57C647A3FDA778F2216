        private void LoadEmployeesTab()
        {
            try
            {
                // Map to new schema: NhanVien, TaiKhoan, VaiTro
                string query = @"
                    SELECT nv.MaNhanVien AS EmployeeID, nv.MaCode AS [Mã NV], nv.HoTen AS [Họ và Tên],
                           nv.SoDienThoai AS [SĐT], nv.Email, nv.ChucVu AS [Chức Vụ],
                           tk.TenDangNhap AS [Tên Đăng Nhập], vt.TenVaiTro AS [Quyền Hạn],
                           CASE WHEN nv.DangHoatDong = 1 THEN N'Đang làm' ELSE N'Ngưng' END AS [Trạng Thái]
                    FROM dbo.NhanVien nv
                    LEFT JOIN dbo.TaiKhoan tk ON nv.MaNhanVien = tk.MaNhanVien
                    LEFT JOIN dbo.VaiTro vt ON tk.MaVaiTro = vt.MaVaiTro
                    WHERE (@IsAdmin = 1 OR nv.MaChiNhanh = @MaChiNhanh)
                    ORDER BY nv.MaNhanVien";

                var p = new SqlParameter[] {
                    new SqlParameter("@IsAdmin", UserSession.IsAdmin ? 1 : 0),
                    new SqlParameter("@MaChiNhanh", UserSession.MaChiNhanh)
                };

                DataTable dt = DatabaseHelper.ExecuteQuery(query, p);
                dgvEmployees.DataSource = dt;
                if (dgvEmployees.Columns["EmployeeID"] != null)
                    dgvEmployees.Columns["EmployeeID"].Visible = false;
            }
            catch (Exception ex)
            {
                MessageBox.Show("Lỗi tải nhân viên: " + ex.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
